# ---- LLM (any OpenAI-compatible endpoint) ----
# Gemini free tier (OpenAI-compatible):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.5-flash
# Ollama (local):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:32b-instruct
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Optional comma-separated keys for automatic round-robin & 429 failover:
LLM_API_KEYS=
LLM_MODEL=gemini-3.5-flash
REASONING_EFFORT=high
# Optional separate endpoint/model for Lean proving (e.g., local Ollama with a 7B/8B Lean prover):
#   PROVER_BASE_URL=http://localhost:11434/v1
#   PROVER_MODEL=hf.co/mradermacher/Goedel-Prover-V2-8B-GGUF:Q4_K_M
PROVER_BASE_URL=
PROVER_API_KEY=
PROVER_MODEL=
# Embeddings for your own library. Gemini: gemini-embedding-001. Ollama: nomic-embed-text.
# Empty = offline hashed bag-of-words (zero API calls, works offline).
EMBED_BASE_URL=
EMBED_MODEL=gemini-embedding-001

# ---- Academic sources ----
CONTACT_EMAIL=you@example.com       # polite pool for OpenAlex / Crossref
S2_API_KEY=                         # optional free key, avoids Semantic Scholar 429s
CORE_API_KEY=                       # optional free key from core.ac.uk/services/api
STACKEXCHANGE_KEY=                  # optional free key from stackapps.com (raises quota 300 -> 10,000/day)

# ---- Storage ----
DATA_DIR=./data                     # SQLite cache, vector store, PDFs
RUNS_DIR=./runs                     # exported reports

# ---- Lean ----
LEAN_MODE=docker                    # docker | local
LEAN_IMAGE=mathagent-lean
LEAN_WORKERS=2                      # parallel REPL processes (each ~4-8 GB RAM)
LEAN_MEM=4g
REPL_MEM=8g
LEAN_CPUS=2
LEAN_TIMEOUT=120
REPL_BIN=/home/lean/repl/.lake/build/bin/repl
LEAN_PROJECT_DIR=                   # only for LEAN_MODE=local

# ---- Tactic search & solver quality ----
SEARCH_BUDGET=300                   # tactic calls per hole
SEARCH_SECONDS=600
TACTICS_PER_NODE=6
RESEARCH_ROUNDS=3
PAPERS_TO_READ=8
SOLVE_CANDIDATES=3                  # Best-of-N parallel informal proof drafts
INFORMAL_REVISIONS=3

# ---- Python / SymPy sandbox ----
PY_MODE=docker                      # docker | local (local = rlimits only, not sandboxed)
PY_IMAGE=mathagent-py
